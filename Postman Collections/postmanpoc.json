			"event": [
				{
					"listen": "test",
					"script": {
						"id": "120c2814-3d1e-485d-b248-45346a4b25a5",
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"pm.test(\"Booking ID should not be null\", function () {\r",
							"    let jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.bookingid).to.not.be.null;\r",
							"});\r",
							"pm.test(\"Firstname and Lastname should match request JSON\", function () {\r",
							"    // Parse request body\r",
							"    let requestData = JSON.parse(pm.request.body.raw);\r",
							"\r",
							"    // Parse response body\r",
							"    let responseData = pm.response.json();\r",
							"\r",
							"    // Validate firstname\r",
							"    pm.expect(responseData.booking.firstname)\r",
							"        .to.eql(requestData.firstname);\r",
							"\r",
							"    // Validate lastname\r",
							"    pm.expect(responseData.booking.lastname)\r",
							"        .to.eql(requestData.lastname);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
